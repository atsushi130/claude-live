#!/usr/bin/env bash
# 音声のやり取りが終わったときに呼ぶ。SubagentStop と SessionEnd の両方から使う。
#
# SubagentStop: claude-live スキルは専用のエージェント（agent: claude-live:claude-live）で
# 走るので、ペイロードの agent_type を見れば、終わったのが音声セッションか他の
# サブエージェントかを区別できる。他のものなら何もしない。
#
# SessionEnd: セッションごと終わるので、誰のサブエージェントかは問わない。
# **こちらが要るのは、MCP サーバーが必ずしも自分で片付けられないため。**
# 標準入力が閉じれば印を外してから終わるが、強制終了させられるとその機会がない。
# 印が残るとオーバーレイが消えず、次に「他が使用中」と誤判定される元にもなる。
# SessionEnd は harness が呼ぶので、サーバーの死に方に依存しない。
#
# 標準入力に来る JSON（session_id / agent_type / hook_event_name）を読む。手で試すときは:
#   echo '{"hook_event_name":"SubagentStop","agent_type":"claude-live:claude-live","session_id":"..."}' | ./end-voice-session
set -uo pipefail

MARKS="$HOME/.local/state/claude-live/voice"
ON_END="$HOME/.config/claude-live/on-end"
STATE="$HOME/.local/state/claude-live"

# 何が起きたかを追えるようにしておく。片付かないときに知りたいのは
# 「呼ばれていない」のか「呼ばれたが素通りした」のかで、外からは区別できない。
# 状態ディレクトリを作っていない環境では書かない。
log() {
  [ -d "$STATE" ] || return 0
  printf '%s [end-voice-session] %s\n' "$(date '+%m-%d %H:%M:%S')" "$*" >> "$STATE/hook.log"
}

payload=$(cat)

# jq は入っているとは限らないので python3 で読む。壊れた JSON なら空を返して黙って終わる。
read -r event agent_type session_id <<EOF
$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print(" ")
    raise SystemExit
print(data.get("hook_event_name") or "-", data.get("agent_type") or "-", data.get("session_id") or "-")
' 2>/dev/null)
EOF

# セッションごと終わるなら、誰のサブエージェントだったかは問わない。
# それ以外は claude-live の音声セッションが終わったときだけ動く。
# プラグインのエージェントは名前空間つきで見えるが、素の名前も受けておく。
log "受信 event=$event agent_type=$agent_type session=$session_id"

if [ "$event" != "SessionEnd" ]; then
  case "$agent_type" in
    claude-live | claude-live:claude-live) ;;
    *) log "対象外の agent_type なので何もしない"; exit 0 ;;
  esac
fi

# このセッションが置いた印だけを外す。他のセッションの音声は続いているかもしれない。
removed=0
if [ -d "$MARKS" ] && [ "$session_id" != "-" ]; then
  for mark in "$MARKS"/*; do
    [ -f "$mark" ] || continue
    if [ "$(cat "$mark" 2>/dev/null)" = "$session_id" ]; then
      rm -f "$mark"
      removed=$((removed + 1))
    fi
  done
fi
log "自分の印を $removed 件外した。残り: [$(ls "$MARKS" 2>/dev/null | tr '\n' ' ')]"

# 片付けの中身は利用者に任せる。置いていなければ何もしない。
# 残った印を見て「他のセッションがまだ音声中か」を判断するのは on-end 側の仕事。
if [ -x "$ON_END" ]; then
  "$ON_END"
  log "on-end を呼んだ（終了コード $?）"
else
  log "on-end が無いので何もしない"
fi
exit 0
